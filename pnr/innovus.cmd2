editPin -pin {adc_channel[2] adc_channel[1] adc_channel[0] adc_sample[0] adc_sample[1] adc_sample[2] adc_sample[3] adc_sample[4] adc_sample[5] adc_sample[6] adc_sample[7]} -side TOP -layer Metal4 -spreadType RANGE -start {440 596} -end {590 596} -spacing 2 -pinWidth 0.4 -pinDepth 0.8
editPin -pin {spi_sclk spi_cs_n spi_miso scan_en scan_clk scan_in rst_n clk} -side RIGHT -layer Metal4 -spreadType RANGE -start {596 250} -end {596 430} -spacing 2 -pinWidth 0.4 -pinDepth 0.8
saveDesign 03_after_correct_signal_pins.enc
addRing -nets {VDD VSS} -type core_rings -follow core -layer {top Metal5 bottom Metal5 left Metal4 right Metal4} -width 1 -spacing 1 -offset 0
addStripe -nets {VDD VSS} -layer Metal4 -direction vertical -width 1 -spacing 1 -set_to_set_distance 40 -start_offset 20
sroute -connect {corePin floatingStripe padRing} -nets {VDD VSS}
verifyConnectivity -type special -nets {VDD VSS}
saveDesign 04_after_pg_pre_place.enc
setPlaceMode -congEffort auto -timingDriven 1 -clkGateAware 1
placeDesign
optDesign -preCTS -numPaths 200
optDesign -postCTS -hold -numPaths 200
clockDesign -specFile ./Clock_gpdk.ctstch -outDir clock_report
optDesign -postCTS -numPaths 200
optDesign -postCTS -hold -numPaths 200
saveDesign 06_postCTS.enc
addFiller -cell {FILL64 FILL32 FILL16 FILL8 FILL4 FILL2 FILL1} -prefix FILLER
saveDesign 07_after_filler.enc
setNanoRouteMode -quiet -routeTopRoutingLayer 6
routeDesign -globalDetail
verifyConnectivity -type special -nets {VDD VSS}
verifyConnectivity -type all -error 1000 -warning 50
verify_drc -report bmi_final_check_correct_pins.drc.rpt -limit 1000
setAnalysisMode -analysisType onChipVariation -cppr both
timeDesign -postRoute -pathReports -drvReports -slackReports -numPaths 50
selectInst FILLER_impl0_30542
zoomBox 45.712 462.033 198.007 314.244
zoomBox 91.446 421.067 128.034 384.709
zoomBox 100.456 410.415 109.410 403.932
deselectAll
