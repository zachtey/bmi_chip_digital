write_sdf bmi_chip_top_clean_correct_pins.sdf
streamOut bmi_chip_top_clean_correct_pins.gds -mapFile /vol/eecs391/GPDK045/gpdk045_v_6_0/soce/streamOut.map -libName DesignLib -units 2000 -mode ALL -merge /vol/eecs391/GPDK045/gsclib045_all_v4.8/gsclib045/gds/gsclib045.gds
verifyConnectivity -type special -nets {VDD VSS}
verifyConnectivity -type all -error 1000 -warning 50
verify_drc -report bmi_final_check_correct_pins.drc.rpt -limit 1000
streamOut bmi_chip_top_clean_correct_pins.gds -mapFile /vol/eecs391/GPDK045/gpdk045_v_6_0/soce/streamOut.map -libName DesignLib -units 2000 -mode ALL -merge /vol/eecs391/GPDK045/gsclib045_all_v4.8/gsclib045/gds/gsclib045.gds
